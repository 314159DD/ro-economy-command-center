# The server being tracked: its FluxCP control panel and its wiki.
RO_CP_URL=https://your-server.example/cp/
RO_WIKI_URL=https://your-server.example/wiki/
# fluxSessionData cookie value from browser DevTools after logging into the control panel
RO_SESSION_COOKIE=
DATABASE_URL=postgresql://user:pass@host/db
# optional:
CHAR_LEVEL=72
# THROTTLE_SECONDS=2  (raise if you see 429s in logs)
